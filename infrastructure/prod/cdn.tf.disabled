# Azure Front Door Profile
resource "azurerm_cdn_frontdoor_profile" "main" {
  name                = "${local.prefix}-frontdoor"
  resource_group_name = azurerm_resource_group.main.name
  sku_name            = "Standard_AzureFrontDoor"
}


# Front Door Endpoint
resource "azurerm_cdn_frontdoor_endpoint" "storefront" {
  name                     = "${local.prefix}-storefront"
  cdn_frontdoor_profile_id = azurerm_cdn_frontdoor_profile.main.id
}


# Origin Group
resource "azurerm_cdn_frontdoor_origin_group" "storefront" {
  name                     = "storefront-origin-group"
  cdn_frontdoor_profile_id = azurerm_cdn_frontdoor_profile.main.id

  load_balancing {
    sample_size                 = 4
    successful_samples_required = 3
  }

  health_probe {
    path                = "/"
    request_type        = "HEAD"
    protocol            = "Https"
    interval_in_seconds = 30
  }
}


# Container App as Front Door Origin
resource "azurerm_cdn_frontdoor_origin" "storefront" {
  name                          = "storefront-origin"
  cdn_frontdoor_origin_group_id = azurerm_cdn_frontdoor_origin_group.storefront.id

  enabled                        = true
  host_name                      = azurerm_container_app.storefront.ingress[0].fqdn
  origin_host_header             = azurerm_container_app.storefront.ingress[0].fqdn
  http_port                      = 80
  https_port                     = 443
  certificate_name_check_enabled = true
}


# Route traffic from Front Door to Container App
resource "azurerm_cdn_frontdoor_route" "storefront" {
  name                          = "storefront-route"
  cdn_frontdoor_endpoint_id     = azurerm_cdn_frontdoor_endpoint.storefront.id
  cdn_frontdoor_origin_group_id = azurerm_cdn_frontdoor_origin_group.storefront.id

  cdn_frontdoor_origin_ids = [
    azurerm_cdn_frontdoor_origin.storefront.id
  ]

  supported_protocols    = ["Http", "Https"]
  patterns_to_match      = ["/*"]
  forwarding_protocol    = "HttpsOnly"
  link_to_default_domain = true
  https_redirect_enabled = true
}